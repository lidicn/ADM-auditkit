def cmd_echo(args) -> int:
    """Echo：跨过程「沉默链」检测。

    判据不是"这个 except 里有没有 logger"（那是 rules/generic 下
    py.silent_except_no_trace / py.print_trace_not_logger 的面），而是：
    **失败信号沿调用图往上传播，最后有没有变成任何一个可观测决策**。
    没有 → 断链。与单文件规则正交，故独立成子命令而非一条 L3 规则。
    """
    cmd = [sys.executable, str(ECHO / "echo_scan.py")]
    if args.selftest:
        cmd.append("--selftest")
    else:
        cmd.append(args.path or ".")
        if args.out:
            cmd.append(args.out)
    p = subprocess.run(cmd, capture_output=True, text=True)
    print(p.stdout)
    if p.stderr:
        print(p.stderr, file=sys.stderr)
    return p.returncode


def cmd_round_all(args) -> int:
    """批量并行扫描多个项目。

    哲学：扫描并行（分钟级，边际成本趋近零），triage 分批（按 criticality 排队）。
    """
    import concurrent.futures

    # 确定项目列表
    if args.projects:
        projects = [p.strip() for p in args.projects.split(",")]
    else:
        pr = load_projects()
        projects = list(pr.get("projects", {}).keys())

    if not projects:
        print("错误: 没有指定项目，且配置表为空")
        return 2

    print(f"=== 批量并行扫描: {len(projects)} 个项目, round-{args.round:03d}, mode={args.mode} ===")
    print(f"项目: {', '.join(projects)}")
    print()

    def run_one(project: str) -> tuple[str, int, str]:
        """跑一个项目的审计，返回 (project, returncode, output)。"""
        cmd = [sys.executable, str(ROOT / "auditkit"), "round", project,
               "--round", str(args.round), "--mode", args.mode]
        if args.rules:
            cmd.extend(["--rules", args.rules])
        p = subprocess.run(cmd, capture_output=True, text=True)
        return project, p.returncode, p.stdout + p.stderr

    # 并行执行
    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(projects)) as executor:
        futures = {executor.submit(run_one, p): p for p in projects}
        for future in concurrent.futures.as_completed(futures):
            project, rc, output = future.result()
            results[project] = (rc, output)
            status = "✅" if rc == 0 else "❌"
            print(f"[{status}] {project} 完成 (exit={rc})")

    # 汇总
    print()
    print("=== 汇总 ===")
    for project in projects:
        rc, output = results.get(project, (1, ""))
        status = "成功" if rc == 0 else "失败"
        # 提取 findings 数量
        findings_match = re.search(r"findings\s+(\d+)", output)
        findings = findings_match.group(1) if findings_match else "?"
        print(f"  {project}: {status} | findings={findings}")

    print()
    print("⚠ 注意：扫描已并行完成，但 triage（裁决）请分批进行——")
    print("  按 criticality 排队，单次只裁一个项目的队列，裁完回灌规则再开下一个。")

    return 0 if all(rc == 0 for rc, _ in results.values()) else 1


def main() -> int:
    ap = argparse.ArgumentParser(prog="auditkit", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p1 = sub.add_parser("profile", help="探测项目画像")
    p1.add_argument("path")
    p1.add_argument("--json", action="store_true", help="只输出 JSON")
    p1.set_defaults(func=cmd_profile)

    ps = sub.add_parser("sync", help="克隆/更新项目仓库（离线会明确失败）")
    ps.add_argument("name", nargs="?")
    ps.set_defaults(func=cmd_sync)

    p2 = sub.add_parser("list", help="列出已配置项目")
    p2.set_defaults(func=cmd_list)

    p3 = sub.add_parser("selftest", help="跑分析器自检门禁")
    p3.add_argument("--update", action="store_true")
    p3.set_defaults(func=cmd_selftest)

    p4 = sub.add_parser("round", help="对某项目执行一轮审计")
    p4.add_argument("name_or_path")
    p4.add_argument("--path", help="直接指定本地路径（忽略配置表）")
    p4.add_argument("--round", type=int, default=1)
    p4.add_argument("--legacy", action="store_true",
                    help="同时运行 legacy/ 下 19 个旧分析器（默认关闭，只跑 rules/ 新规则）")
    # P1-3：轮次模式分流
    p4.add_argument("--mode", choices=["full", "delta", "targeted", "regression"],
                    default="full",
                    help="轮次模式：full=全量, delta=只审git diff文件, targeted=指定规则, regression=仅确证bug对应规则")
    p4.add_argument("--rules", help="targeted 模式：指定规则 ID（逗号分隔）")
    p4.set_defaults(func=cmd_round)

    p5 = sub.add_parser("status", help="查看项目缺陷台账")
    p5.add_argument("name_or_path")
    p5.add_argument("--path")
    p5.set_defaults(func=cmd_status)

    p6 = sub.add_parser("pack", help="打包项目审计产物")
    p6.add_argument("name_or_path")
    p6.add_argument("--path")
    p6.set_defaults(func=cmd_pack)

    pe = sub.add_parser("echo", help="Echo：跨过程沉默链检测（失败信号是否转化为可观测）")
    pe.add_argument("path", nargs="?", help="项目源码根（默认 .）")
    pe.add_argument("--out", help="输出 JSON 路径")
    pe.add_argument("--selftest", action="store_true",
                    help="跑已知阳性自检（dirty 必须命中 / clean 必须不命中）")
    pe.set_defaults(func=cmd_echo)

    p7 = sub.add_parser("rules", help="规则层：列出/自测 L3 规则（Phase 1 新增）")
    p7sub = p7.add_subparsers(dest="rules_cmd", required=True)
    p7l = p7sub.add_parser("list", help="列出已加载规则（id/name/mode/applies_to/status）")
    p7l.add_argument("--project", help="按 applies_to 过滤显示")
    p7l.add_argument("--all", action="store_true", help="包含 draft/deprecated/broken")
    p7l.add_argument("--json", action="store_true")
    p7t = p7sub.add_parser("test", help="单独跑某规则的 dirty/clean 自检")
    p7t.add_argument("rule_id")
    p7t.add_argument("--json", action="store_true")
    p7.set_defaults(func=cmd_rules)

    p8 = sub.add_parser("propose", help="元宝迭代通道：生成/列出/查看标准化变更提案包（Phase 4 新增）")
    p8sub = p8.add_subparsers(dest="propose_cmd", required=True)
    p8c = p8sub.add_parser("create", help="生成变更提案包（自动收集改动文件+跑测试+生成CHANGE.yaml）")
    p8c.add_argument("--type", required=True, choices=["rule", "engine", "profile"],
                     help="提案类型：rule=规则变更, engine=引擎/模式变更, profile=项目适配变更")
    p8c.add_argument("--name", required=True, help="提案名称（用于目录名，如 py_new_rule）")
    p8c.add_argument("--title", help="提案标题（默认用 name）")
    p8c.add_argument("--summary", help="变更摘要：改了什么、为什么改")
    p8c.add_argument("--scope", help="影响范围（默认根据类型推断）")
    p8c.add_argument("--risk", choices=["low", "medium", "high"],
                     help="风险等级（默认 rule=low, engine=medium, profile=low）")
    p8c.add_argument("--verify-cmd", help="验证命令（默认跑测试+规则自测）")
    p8c.add_argument("--author", default="yuanbao", help="作者（默认 yuanbao）")
    p8l = p8sub.add_parser("list", help="列出所有提案包")
    p8s = p8sub.add_parser("show", help="查看某个提案包摘要")
    p8s.add_argument("--name", required=True, help="提案包目录名（支持模糊匹配）")
    p8.set_defaults(func=cmd_propose)

    # P0-2：命中集 diff —— 规则/共享判据变更后分钟级验证
    p9 = sub.add_parser("diff", help="对比两轮命中集（规则变更后验证 added/removed）")
    p9.add_argument("project", help="项目名")
    p9.add_argument("round_a", type=int, help="基准轮次")
    p9.add_argument("round_b", type=int, help="对比轮次")
    p9.set_defaults(func=cmd_diff)

    # P1-1：triage 裁决落盘 —— 人工裁决按 (rule, file, line) 写进项目 profile
    p10 = sub.add_parser("triage", help="裁决落盘：accept/reject/list/apply")
    p10.add_argument("triage_cmd", choices=["accept", "reject", "list", "apply"])
    p10.add_argument("project", nargs="?", help="项目名")
    p10.add_argument("--rule", help="规则 ID")
    p10.add_argument("--file", help="文件路径")
    p10.add_argument("--line", type=int, help="行号")
    p10.add_argument("--reason", help="裁决原因")
    p10.add_argument("--round", type=int, help="apply 时指定轮次")
    p10.set_defaults(func=cmd_triage)

    # 新增：scout 手猎轮 —— 工作流消费经验，不生产经验。新项目首轮先手猎。
    p11 = sub.add_parser("scout", help="手猎轮：初始化四件套（假设/方言/规则草案/四问）")
    p11.add_argument("project", help="项目名")
    p11.set_defaults(func=cmd_scout)

    # 新增：reconcile 对账 —— 手猎结论 vs 工具结论，输出差异表
    p12 = sub.add_parser("reconcile", help="对账：手猎结论 vs 工具结论")
    p12.add_argument("project", help="项目名")
    p12.add_argument("--round", type=int, default=1, help="对比轮次")
    p12.set_defaults(func=cmd_reconcile)

    # 新增：round-all 批量并行扫描 —— 扫描并行，triage 分批
    p13 = sub.add_parser("round-all", help="批量并行扫描多个项目（扫描并行，triage 分批）")
    p13.add_argument("--projects", help="项目名列表（逗号分隔，默认全部已配置项目）")
    p13.add_argument("--round", type=int, default=1, help="轮次号")
    p13.add_argument("--mode", choices=["full", "delta", "targeted", "regression"],
                     default="full", help="轮次模式（同 round --mode）")
    p13.add_argument("--rules", help="targeted 模式：指定规则 ID（逗号分隔）")
    p13.set_defaults(func=cmd_round_all)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
