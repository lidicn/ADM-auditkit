def _engine_loader():
    """惰性加载新引擎规则层 —— 缺失时只影响 `rules` 子命令，不影响旧命令。"""
    import importlib
    if str(ROOT) not in sys.path:
        sys.path.insert(0, str(ROOT))
    return importlib.import_module("engine.loader")


def cmd_rules(args) -> int:
    """规则层入口（Phase 1 新增）：rules list / rules test。"""
    loader = _engine_loader()
    if args.rules_cmd == "list":
        report = loader.load_rules()
        rows = []
        want = getattr(args, "project", None)
        for rule in list(report.registry) + list(report.broken.values()):
            if want and rule.applies_to and want not in rule.applies_to:
                continue
            if not getattr(args, "all", False) and rule.status not in ("active", "testing"):
                continue
            rows.append({"id": rule.id, "name": rule.name, "mode": rule.mode,
                         "applies_to": rule.applies_to, "status": rule.status,
                         "severity": rule.severity, "version": rule.version})
        rows.sort(key=lambda r: r["id"])
        if getattr(args, "json", False):
            print(json.dumps(rows, ensure_ascii=False, indent=2))
        else:
            print(f"{'id':<32} {'mode':<12} {'status':<10} {'severity':<9} "
                  f"{'applies_to':<22} name")
            for r in rows:
                ap = ",".join(r["applies_to"]) or "*"
                print(f"{r['id']:<32} {r['mode']:<12} {r['status']:<10} "
                      f"{r['severity']:<9} {ap:<22} {r['name']}")
            print(f"共 {len(rows)} 条（loaded={len(report.registry)} broken={len(report.broken)}）")
        return 0
    if args.rules_cmd == "test":
        rid = args.rule_id
        try:
            rule, results = loader.test_rule_by_id(rid)
        except KeyError:
            report = loader.load_rules()
            print(f"未找到规则 {rid}；可用: {report.active_ids() or '（无）'}")
            return 2
        print(f"规则 {rule.id}（{rule.name}）自检：")
        ok_all = True
        for r in results:
            mark = "PASS" if r.ok else "FAIL"
            ok_all = ok_all and r.ok
            print(f"  [{mark}] {r.kind:<5} {r.name:<20} hits={r.hits} {r.message}")
        print("结论:", "通过" if ok_all else "不通过（规则将被标 broken，不参与审计）")
        return 0 if ok_all else 1
    print(f"未知 rules 子命令: {args.rules_cmd}")
    return 2


def cmd_propose(args) -> int:
    """Phase 4: 元宝迭代通道 —— 生成/列出/查看标准化变更提案包。"""
    from engine.propose import create_proposal, list_proposals, show_proposal, PROPOSALS_DIR

    if args.propose_cmd == "create":
        if not args.type or not args.name:
            print("错误: propose create 需要 --type 和 --name")
            return 2
        try:
            proposal_dir = create_proposal(
                ptype=args.type,
                name=args.name,
                title=args.title,
                summary=args.summary or "",
                scope=args.scope or "",
                risk=args.risk,
                verify_cmd=args.verify_cmd,
                author=args.author or "yuanbao",
            )
        except ValueError as e:
            print(f"错误: {e}")
            return 2
        print(f"提案包已生成: {proposal_dir}")
        print(f"  CHANGE.yaml: {proposal_dir / 'CHANGE.yaml'}")
        if (proposal_dir / "files").exists():
            file_count = sum(1 for _ in (proposal_dir / "files").rglob("*") if _.is_file())
            print(f"  files/: {file_count} 个变更文件")
        if (proposal_dir / "evidence").exists():
            ev_count = sum(1 for _ in (proposal_dir / "evidence").rglob("*") if _.is_file())
            print(f"  evidence/: {ev_count} 个验证证据")
        print(f"\n下一步: 把提案包发给维护者审核，维护者运行 CHANGE.yaml 中的 verify_cmd 后合入")
        return 0

    elif args.propose_cmd == "list":
        proposals = list_proposals()
        if not proposals:
            print(f"暂无提案包（目录: {PROPOSALS_DIR}）")
            return 0
        print(f"提案包列表（共 {len(proposals)} 个）:")
        for p in proposals:
            print(f"  {p.name}")
        return 0

    elif args.propose_cmd == "show":
        if not args.name:
            print("错误: propose show 需要 --name（提案包目录名）")
            return 2
        proposal_dir = PROPOSALS_DIR / args.name
        if not proposal_dir.exists():
            # 尝试模糊匹配
            matches = [p for p in PROPOSALS_DIR.iterdir() if args.name in p.name] if PROPOSALS_DIR.exists() else []
            if len(matches) == 1:
                proposal_dir = matches[0]
            else:
                print(f"错误: 提案包不存在: {args.name}")
                if matches:
                    print(f"  可能匹配: {[m.name for m in matches]}")
                return 1
        print(show_proposal(proposal_dir))
        return 0

    print(f"未知 propose 子命令: {args.propose_cmd}")
    return 2


