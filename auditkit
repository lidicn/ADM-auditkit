#!/usr/bin/env python3
"""auditkit —— 多项目审计统一入口。

AF 的工作流是**单项目硬编码**的：路径写死 `src/src/autoforge`，
只能 `bash af_audit.sh round-020 --force`。要同时维护四个仓库，
靠记住每个的调用方式不现实。

本 CLI 提供统一入口：

  auditkit profile <path>          探测项目画像（语言/框架/入口/自建门禁）
  auditkit selftest                跑分析器自检门禁
  auditkit round <project>         对某项目执行一轮审计
  auditkit status <project>        查看该项目缺陷台账
  auditkit list                    列出已配置项目
  auditkit pack <project>          打包该项目审计产物
  auditkit rules list              列出已加载规则（id/name/mode/applies_to/status）
  auditkit rules test <rule_id>    单独跑某规则的 dirty/clean 自检

项目在 config/projects.yaml 里声明；不在表里也能直接用 --path 临时指定。
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
CORE = ROOT / "core"
ENGINE = ROOT / "engine"
ECHO = CORE / "echo"
CONFIG = ROOT / "config"
# 环境变量覆盖：容器内 /workspace 只读时，设 AUDITKIT_PROJECTS_DIR=/audit-out/projects
# 让 round 产物写到可写卷（开发规范 §1：NAS 是运行环境，产物落可写区）
PROJECTS_DIR = Path(os.environ.get("AUDITKIT_PROJECTS_DIR") or (ROOT / "projects"))
SELFTEST = ROOT / "selftest"


def _parse_projects_yaml(f) -> dict:
    try:
        import yaml  # type: ignore
        return yaml.safe_load(f.read_text()) or {}
    except ImportError:
        # 无 pyyaml 时做极简解析（只支持本文件用到的扁平结构）
        out, cur = {}, None
        for line in f.read_text().splitlines():
            if not line.strip() or line.strip().startswith("#"):
                continue
            if not line.startswith(" ") and line.rstrip().endswith(":"):
                cur = line.rstrip()[:-1]
                out[cur] = {}
            elif cur and ":" in line:
                k, _, v = line.strip().partition(":")
                out[cur][k] = v.strip().strip("\"'")
        return out


def load_projects() -> dict:
    """项目登记表：本地覆盖档优先（2026-10-12 路径双档）。

    config/projects.yaml        部署口径，path 用容器内 /data/workspace/repos/*，入库
    config/projects.local.yaml  本地口径，path 用 Windows E:/NAS/*，gitignore；
                                存在时整体覆盖 projects.yaml（不是逐键合并——
                                两档的 path 语义互斥，混用会一半可达一半不可达）
    """
    for name in ("projects.local.yaml", "projects.yaml"):
        f = CONFIG / name
        if not f.exists():
            continue
        data = _parse_projects_yaml(f)
        if data:
            return data
    return {}


def cmd_profile(args) -> int:
    cmd = [sys.executable, str(CORE / "profile.py"), str(Path(args.path).resolve())]
    if getattr(args, "json", False):
        cmd.append("--json")
    p = subprocess.run(cmd, capture_output=True, text=True)
    print(p.stdout or p.stderr)
    return p.returncode


def cmd_list(args) -> int:
    pr = load_projects().get("projects", {})
    rows = [{"name": k, **{kk: vv for kk, vv in v.items() if kk in ("repo", "path", "known_stack")}}
            for k, v in pr.items()]
    print(json.dumps(rows, ensure_ascii=False, indent=2))
    return 0


def cmd_selftest(args) -> int:
    script = SELFTEST / "run_selftest.py"
    if not script.exists():
        print("自检套件缺失")
        return 2
    argv = [sys.executable, str(script)]
    if args.update:
        argv.append("--update")
    p = subprocess.run(argv, capture_output=True, text=True)
    try:
        d = json.loads(p.stdout)
    except Exception:
        print(p.stdout, p.stderr)
        return 1
    print("自检结果:", "通过" if d.get("ok") else "失败")
    print("分析器数:", d.get("analyzers"))
    # 三态分组（proposal-2 建议 7）：tools_missing / ok_but_no_hit / ok
    statuses = d.get("statuses", {})
    if statuses:
        from collections import Counter
        grp = Counter(statuses.values())
        print("状态分布:", dict(grp))
        for s in ("tools_missing", "ok_but_no_hit"):
            bad = [k for k, v in statuses.items() if v == s]
            if bad:
                print(f"  ⚠ {s}:", bad)
    if d.get("dirty_hits"):
        zero = [k for k, v in d["dirty_hits"].items() if v == 0]
        print("❌ 0 命中（规则可能失效）:", zero or "无")
    if d.get("clean_hits"):
        print("clean 样本命中:", {k: v for k, v in d["clean_hits"].items() if v} or "无")
    # drift 红警（规则消失/新增——双向检测，门禁健全性证据）
    drift = d.get("drift", [])
    if drift:
        print(f"drift 红警（{len(drift)} 条）:")
        for line in drift[:15]:
            print("  ", line)
        if len(drift) > 15:
            print(f"  ... 还有 {len(drift) - 15} 条")
    for f in d.get("failures", []):
        print("  ", f)
    return 0 if d.get("ok") else 1


def _resolve(args) -> tuple[str, Path]:
    if getattr(args, "path", None):
        # --path 优先级高于位置参数名（否则位置参数被当成路径，找不到就误报）
        return Path(args.name_or_path).name, Path(args.path).resolve()
    pr = load_projects()
    cfg = pr.get("projects", {}).get(args.name_or_path)
    if not cfg:
        sys.exit(f"未找到项目 {args.name_or_path}；可用: "
                 f"{list(pr.get('projects', {}))} 或用 --path 直接指定")
    return args.name_or_path, Path(cfg.get("path", "")).expanduser().resolve()


def cmd_round(args) -> int:
    name, path = _resolve(args)
    if not path.exists():
        print(f"[warn] 本地路径不存在: {path}")
        print("      仓库未克隆时无法审计。请先 clone，或用 --path 指向已有副本。")
        return 2
    round_dir = PROJECTS_DIR / name / f"round-{args.round:03d}"
    round_dir.mkdir(parents=True, exist_ok=True)

    # 1) 画像
    print(f"── 画像探测 {name}")
    pf = subprocess.run([sys.executable, str(CORE / "profile.py"), str(path), "--json"],
                        capture_output=True, text=True)
    try:
        profile = json.loads(pf.stdout)
    except Exception:
        # 兜底：profile 若把人类可读摘要混进 stdout，取最后一段 {...}
        s = pf.stdout
        i, j = s.rfind("{\n"), s.rfind("}")
        if i >= 0 and j > i:
            try:
                profile = json.loads(s[i:j + 1])
            except Exception:
                print(pf.stdout[-1500:], pf.stderr[-1500:]); return 1
        else:
            print(pf.stdout[-1500:], pf.stderr[-1500:]); return 1
    (round_dir / "profile.json").write_text(json.dumps(profile, ensure_ascii=False, indent=2))
    L = profile.get("languages", {})
    print(f"  主语言 {L.get('primary')}  文件数 {L.get('files')}  行 {L.get('lines')}")
    print(f"  框架   {', '.join(profile.get('frameworks', [])) or '（未识别）'}")

    # 2) 语言无关的 package root 判定
    pkg = path
    ppkgs = profile.get("python_packages") or []
    if ppkgs:
        cand = path / ppkgs[0]["path"]
        if cand.is_dir():
            pkg = cand                      # 画像指出的主包（模块数最多）
    if pkg == path:                         # 回退：常见布局
        for cand_name in ("src", path.name, "app", "lib"):
            c = path / cand_name
            if c.is_dir():
                pkg = c
                break

    # 3) 跑分析器（新引擎 Phase 2：engine/runner.py 替代 core/registry.py subprocess）
    print(f"── 引擎分派 → {round_dir / 'findings'}")
    # 附加扫描根：项目自建的门禁脚本目录（profile 已探测）
    extra_roots = []
    for s in profile.get("gates", {}).get("self_check_scripts", []):
        d = path / Path(s).parent
        if d.is_dir():
            extra_roots.append(d)
    for c in profile.get("gates", {}).get("ci", []):
        d = path / c["path"]
        if d.is_dir() and d.name == "scripts":
            extra_roots.append(d)
    try:
        from engine.runner import run_round
        # P1-3：轮次模式分流
        mode = getattr(args, "mode", "full")
        file_filter = None
        rule_filter = None

        if mode == "delta":
            # 只审 git diff 涉及的文件
            try:
                r = subprocess.run(["git", "diff", "--name-only", "HEAD"],
                                   capture_output=True, text=True, cwd=path, timeout=10)
                if r.returncode == 0:
                    file_filter = [l for l in r.stdout.strip().split("\n") if l]
                    print(f"  [delta 模式] 只审 {len(file_filter)} 个变更文件")
            except Exception as e:
                print(f"  [delta 模式] git diff 失败，回退全量: {e}")

        elif mode == "targeted":
            # 只跑指定规则
            if getattr(args, "rules", None):
                rule_filter = [r.strip() for r in args.rules.split(",")]
                print(f"  [targeted 模式] 只跑 {len(rule_filter)} 条规则: {rule_filter}")

        elif mode == "regression":
            # 仅确证 bug 对应规则（从 bugs.json 读取）
            bugs_file = PROJECTS_DIR / name / "bugs.json"
            if bugs_file.exists():
                bugs = json.loads(bugs_file.read_text(encoding="utf-8"))
                rule_filter = list({b["rule"] for b in bugs.get("bugs", []) if b.get("status") == "open"})
                print(f"  [regression 模式] 只跑 {len(rule_filter)} 条确证 bug 对应规则: {rule_filter}")
            else:
                print(f"  [regression 模式] 无 bugs.json，回退全量")

        # 项目级 skip_dirs 来自 projects.yaml 项目段（非画像 JSON），N10 要求
        proj_cfg = load_projects().get("projects", {}).get(name, {})
        summary = run_round(
            repo_path=path,
            outdir=round_dir,
            profile_path=round_dir / "profile.json",
            extra_roots=extra_roots,
            include_legacy=getattr(args, "legacy", False),
            file_filter=file_filter,
            rule_filter=rule_filter,
            skip_dirs=list(proj_cfg.get("skip_dirs") or []),
        )
        print(f"  分析器 {summary['analyzers_ok']}/{summary['analyzers_total']}  "
              f"findings {summary['total_findings']}  "
              f"规则 active={summary['engine']['active_rules']} broken={summary['engine']['broken_rules']}")
        if summary["engine"]["diagnostics"]:
            for d in summary["engine"]["diagnostics"][:10]:
                print(f"  [diag] {d}")
    except Exception as e:
        print(f"  [引擎异常] {type(e).__name__}: {e}")
        import traceback
        traceback.print_exc()
        return 1

    # 4) 汇总
    agg = CORE / "aggregate.py"
    if agg.exists():
        subprocess.run([sys.executable, str(agg), str(round_dir / "findings"),
                        str(round_dir)], capture_output=True, text=True)

    # 5) 生成人类可读 markdown 报告（投递开发者路径用）
    rep = CORE / "report.py"
    if rep.exists():
        subprocess.run([sys.executable, str(rep), str(round_dir), name],
                       capture_output=True, text=True)
        rp = round_dir / "report.md"
        if rp.exists():
            print(f"  报告: {rp}")
            # 投递提示：report.md 在 round_dir 里，宿主机侧 deliver_report.sh 会拷到
            # 目标项目 doc/审计报告/（容器内 /targets 只读，不能直接写）

    print(f"\n── 完成 → {round_dir}")
    return 0


def cmd_sync(args) -> int:
    """克隆或更新项目仓库。

    离线沙箱里 git 会失败——这时**明确返回非零并说明**，不静默当成"已是最新"，
    否则后续审计会拿旧副本或空目录跑出一个看起来正常的空结果。
    """
    pr = load_projects().get("projects", {})
    names = [args.name] if getattr(args, "name", None) else list(pr)
    rc = 0
    for n in names:
        info = pr.get(n)
        if not info:
            print(f"[skip] 未登记项目: {n}")
            rc = rc or 1
            continue
        path = Path(info.get("path") or (Path("/data/workspace/repos") / n))
        repo = info.get("repo", "")
        path.parent.mkdir(parents=True, exist_ok=True)
        if (path / ".git").is_dir():
            r = subprocess.run(["git", "-C", str(path), "pull", "--ff-only"],
                               capture_output=True, text=True)
            print(f"── pull {n}: rc={r.returncode} {(r.stdout or r.stderr).strip()[:160]}")
            rc = rc or r.returncode
            continue
        if not repo:
            print(f"[skip] {n} 未配置 repo 地址，且本地无副本: {path}")
            rc = rc or 2
            continue
        r = subprocess.run(["git", "clone", "--depth", "1", repo, str(path)],
                           capture_output=True, text=True)
        if r.returncode == 0:
            print(f"── clone {n} → {path}  OK")
        else:
            print(f"── clone {n} 失败（离线/无凭证/仓库不存在）rc={r.returncode}")
            print(f"   {(r.stderr or r.stdout).strip()[:300]}")
            print(f"   无法获取源码 ⇒ 无法审计。请手工放置副本后重跑，或用 --path 指向已有副本。")
            rc = rc or r.returncode
    return rc


def cmd_status(args) -> int:
    name, path = _resolve(args)
    bf = PROJECTS_DIR / name / "baseline" / "bugs.json"
    if not bf.exists():
        print(f"{name}: 尚无台账（{bf}）")
        return 0
    d = json.loads(bf.read_text())
    for b in d.get("bugs", []):
        print(f"  {b['id']:<8} {b.get('severity','?'):<7} {b.get('title','')[:70]}")
    print(f"共 {len(d.get('bugs', []))} 项")
    return 0


def cmd_pack(args) -> int:
    name, path = _resolve(args)
    import zipfile
    src = PROJECTS_DIR / name
    if not src.exists():
        print(f"无产物: {src}")
        return 2
    out = ROOT / f"{name}-audit.zip"
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for p in src.rglob("*"):
            if p.is_file() and "__pycache__" not in p.parts:
                z.write(p, p.relative_to(src.parent))
    print(f"已打包 → {out}")
    return 0


